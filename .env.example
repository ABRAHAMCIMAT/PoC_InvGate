# --- Entorno ---
APP_ENV=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
LOG_USER_CONTENT=false
DATA_DIR=backend/data

# --- Seguridad (Fase 5) ---
# API_KEYS=clave:rol,clave:rol  (roles: user, agent, admin)
CORS_ORIGINS=localhost:8000
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW=60

# --- LLM ---
LLM_PROVIDER=mock
LLM_BASE_URL=http://host.docker.internal:1337/v1
LLM_MODEL=
LLM_API_KEY=

# --- Ticketing ---
# demo (memoria) | simulated (memoria, para Teams) | invgate (real)
TICKETING_PROVIDER=demo
STORAGE_BACKEND=file
APPROVAL_TTL_HOURS=72

# --- InvGate (real) ---
INVGATE_BASE_URL=
INVGATE_API_TOKEN=
INVGATE_USERNAME=api
INVGATE_FIELD_MAP=
INVGATE_VALUE_MAP=
INVGATE_ACTION_TYPE=

# --- Aprobaciones ---
POC_MANAGER_NAME=
POC_MANAGER_EMAIL=
NOTIFY_CHANNEL=teams

# --- Microsoft Teams ---
TEAMS_BOT_APP_ID=
TEAMS_BOT_APP_PASSWORD=
TEAMS_TENANT_ID=
TEAMS_SERVICE_URL=https://smba.trafficmanager.net/teams/
TEAMS_WORKFLOW_URL=
PUBLIC_BASE_URL=

# --- Observabilidad ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
