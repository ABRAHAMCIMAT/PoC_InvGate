# --- Entorno ---
APP_ENV=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
# true envía el texto del usuario (con PII redactada) a Langfuse
LOG_USER_CONTENT=false
DATA_DIR=backend/data

# --- Seguridad ---
# API_KEYS=clave:rol,clave:rol  (roles: user, agent, admin). Obligatorio con APP_ENV=production.
CORS_ORIGINS=http://localhost:8000
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW=60

# --- LLM ---
# mock (sin credenciales) | ollama | jan | openai_compatible
LLM_PROVIDER=mock
# Vacío: http://localhost:11434/v1 (Ollama) o http://localhost:1337/v1 (Jan).
# Desde Docker: http://host.docker.internal:11434/v1
LLM_BASE_URL=
# Vacío: llama3.1:8b (Ollama) o llama3.1-8b-instruct (Jan)
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT=30
LLM_COST_PER_1K_TOKENS=0

# --- Ticketing ---
# demo (memoria) | simulated (archivo, para Teams) | invgate (real)
TICKETING_PROVIDER=demo
STORAGE_BACKEND=file
APPROVAL_TTL_HOURS=72

# --- InvGate (real) ---
INVGATE_BASE_URL=
INVGATE_API_PREFIX=/api/v1
# Opción A: usuario + API token (Basic auth)
INVGATE_USERNAME=api
INVGATE_API_TOKEN=
# Opción B: OAuth 2.0 client credentials (tiene prioridad si se configuran ambos)
INVGATE_CLIENT_ID=
INVGATE_CLIENT_SECRET=
# Vacío: <INVGATE_BASE_URL>/oauth/v2.0/access_token
INVGATE_OAUTH_TOKEN_URL=
# Campos obligatorios para crear incidentes (ids de tu instancia)
# INVGATE_DEFAULTS={"creator_id": 1, "customer_id": 1, "category_id": 1, "source_id": 1}
INVGATE_DEFAULTS=
# Nombres de campo del PoC -> InvGate (por defecto category->category_id, priority->priority_id...)
INVGATE_FIELD_MAP=
# Valores del PoC -> ids de InvGate, p. ej. {"category": {"acceso": "12", "software": "15"}}
INVGATE_VALUE_MAP=
# Usuario de InvGate que firma comentarios y aprobaciones
INVGATE_AUTHOR_ID=
INVGATE_ACTION_TYPE=

# --- Aprobaciones ---
POC_MANAGER_NAME=
# Solo este correo (o su usuario de Teams) puede aprobar
POC_MANAGER_EMAIL=
# Id del manager en InvGate (obligatorio con TICKETING_PROVIDER=invgate)
POC_MANAGER_INVGATE_ID=
# teams (bot) | webhook (TEAMS_WORKFLOW_URL) | none
NOTIFY_CHANNEL=teams

# --- Microsoft Teams ---
TEAMS_BOT_APP_ID=
TEAMS_BOT_APP_PASSWORD=
TEAMS_TENANT_ID=
TEAMS_SERVICE_URL=https://smba.trafficmanager.net/teams/
TEAMS_WORKFLOW_URL=
# URL pública (túnel HTTPS) del PoC, p. ej. https://valkiria.trycloudflare.com
PUBLIC_BASE_URL=

# --- Observabilidad ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
